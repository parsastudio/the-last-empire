{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/domain/*": ["../domain/src/*"],
      "@/engine/*": ["../game-engine/src/*"],
      "@/infrastructure/*": ["./src/*"],
      "@geopolitics/domain": ["../domain/src/index.ts"],
      "@geopolitics/domain/*": ["../domain/src/*"],
      "@geopolitics/game-engine": ["../game-engine/src/index.ts"],
      "@geopolitics/game-engine/*": ["../game-engine/src/*"],
      "@geopolitics/map-pipeline": ["./src/index.ts"],
      "@geopolitics/map-pipeline/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "../domain/src/**/*",
    "../game-engine/src/**/*"
  ]
}

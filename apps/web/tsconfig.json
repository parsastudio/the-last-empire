{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/domain/*": ["../../packages/domain/src/*"],
      "@/engine/*": ["../../packages/game-engine/src/*"],
      "@/infrastructure/*": [
        "./src/infrastructure/*",
        "../../packages/map-pipeline/src/*"
      ],
      "@geopolitics/domain": ["../../packages/domain/src/index.ts"],
      "@geopolitics/domain/*": ["../../packages/domain/src/*"],
      "@geopolitics/game-engine": ["../../packages/game-engine/src/index.ts"],
      "@geopolitics/game-engine/*": ["../../packages/game-engine/src/*"],
      "@geopolitics/map-pipeline": ["../../packages/map-pipeline/src/index.ts"],
      "@geopolitics/map-pipeline/*": ["../../packages/map-pipeline/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/domain/src/**/*",
    "../../packages/game-engine/src/**/*",
    "../../packages/map-pipeline/src/**/*"
  ],
  "exclude": ["node_modules"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/domain/*": ["../../packages/domain/src/*"],
      "@/engine/*": ["../../packages/game-engine/src/*"],
      "@/infrastructure/map-preprocessing/*": [
        "../../packages/map-pipeline/src/map-preprocessing/*"
      ],
      "@/infrastructure/maritime-topology/*": [
        "../../packages/map-pipeline/src/maritime-topology/*"
      ],
      "@/infrastructure/quadtree-map/*": [
        "../../packages/map-pipeline/src/quadtree-map/*"
      ],
      "@/infrastructure/row-spans-map/*": [
        "../../packages/map-pipeline/src/row-spans-map/*"
      ],
      "@/infrastructure/tactical-terrain-enhancer/*": [
        "../../packages/map-pipeline/src/tactical-terrain-enhancer/*"
      ],
      "@/infrastructure/terrain-binary-map/*": [
        "../../packages/map-pipeline/src/terrain-binary-map/*"
      ],
      "@/infrastructure/*": ["./src/infrastructure/*"],
      "@geopolitics/domain": ["../../packages/domain/src/index.ts"],
      "@geopolitics/domain/*": ["../../packages/domain/src/*"],
      "@geopolitics/game-engine": ["../../packages/game-engine/src/index.ts"],
      "@geopolitics/game-engine/*": ["../../packages/game-engine/src/*"],
      "@geopolitics/map-pipeline": ["../../packages/map-pipeline/src/index.ts"],
      "@geopolitics/map-pipeline/*": ["../../packages/map-pipeline/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/domain/src/**/*",
    "../../packages/game-engine/src/**/*",
    "../../packages/map-pipeline/src/**/*"
  ],
  "exclude": ["node_modules"]
}
